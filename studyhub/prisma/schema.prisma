generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

/// Shared lifecycle for courses, subjects, chapters and materials.
/// Students only ever see PUBLISHED content.
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MaterialType {
  FILE
  YOUTUBE
  LINK
  TEXT
  LESSON
}

enum FeeStatus {
  PENDING
  PAID
  WAIVED
}

model User {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  passwordHash       String
  role               Role
  status             UserStatus @default(ACTIVE)
  /// Set when an admin creates the account or resets the password; the user must choose their own at next login.
  mustChangePassword Boolean    @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  studentProfile    StudentProfile?
  adminProfile      AdminProfile?
  sessions          Session[]
  enrollments       Enrollment[]
  materialProgress  MaterialProgress[]
  materialBookmarks MaterialBookmark[]
  subjectBookmarks  SubjectBookmark[]
  uploadedMaterials Material[]         @relation("UploadedBy")
  studentSubjects   StudentSubject[]
  createdTests      Test[]             @relation("CreatedTests")
  testAttempts      TestAttempt[]
  fees              Fee[]

  @@index([role, status])
}

model StudentProfile {
  id        String  @id @default(cuid())
  userId    String  @unique
  studentId String? @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Only a SHA-256 hash of the session token is stored; the raw token lives in an HttpOnly cookie.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A program of study: a degree (BS Computer Science), a class or a track. The label users see lives in lib/terms.ts.
model Course {
  id          String        @id @default(cuid())
  name        String
  description String        @default("")
  status      ContentStatus @default(PUBLISHED)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  semesters   Semester[]
  subjects    Subject[]
  enrollments Enrollment[]
  announcements Announcement[]

  @@index([status, order])
}

/// A term of a program (Semester 1, Semester 2, ...). The order field decides which semesters come earlier.
model Semester {
  id        String   @id @default(cuid())
  courseId  String
  name      String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subjects    Subject[]
  enrollments Enrollment[]

  @@index([courseId, order])
}

/// Schema allows many programs per student; V1 services enforce one.
/// semesterId is the student's CURRENT semester: they can open subjects of that semester and earlier ones.
model Enrollment {
  id         String    @id @default(cuid())
  userId     String
  courseId   String
  semesterId String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester   Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([courseId, semesterId])
}

/// semesterId is empty for a subject that applies to the whole program (visible from the first semester).
model Subject {
  id          String        @id @default(cuid())
  courseId    String
  semesterId  String?
  name        String
  description String        @default("")
  icon        String        @default("book")
  order       Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  course    Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester  Semester?         @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  chapters  Chapter[]
  bookmarks SubjectBookmark[]
  students  StudentSubject[]
  tests     Test[]

  @@index([courseId, semesterId, status, order])
}

model Chapter {
  id            String        @id @default(cuid())
  subjectId     String
  title         String
  description   String        @default("")
  chapterNumber Int
  order         Int           @default(0)
  status        ContentStatus @default(PUBLISHED)
  /// While status is DRAFT, a time in the future here makes it (and its materials) visible on its own once that
  /// time passes — no admin action needed. Ignored once status is PUBLISHED or ARCHIVED. See lib/schedule.ts.
  publishAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  materials Material[]

  @@index([subjectId, status, order])
}

/// A future Topic layer can sit between Chapter and Material via a nullable topicId.
model Material {
  id              String        @id @default(cuid())
  chapterId       String
  type            MaterialType
  title           String
  description     String        @default("")
  // FILE
  fileKey         String?       @unique
  fileName        String?
  mimeType        String?
  fileSize        Int?
  // LINK
  externalUrl     String?
  // YOUTUBE
  youtubeId       String?
  durationSeconds Int?
  // TEXT (sanitized HTML)
  textContent     String?
  // LESSON (validated against lib/lesson.ts; bodies sanitized before storing)
  lessonData      Json?
  order           Int           @default(0)
  status          ContentStatus @default(PUBLISHED)
  /// Same idea as Chapter.publishAt: a DRAFT material with a past publishAt is visible without anyone publishing it.
  publishAt       DateTime?
  uploadedById    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  chapter    Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  uploadedBy User?              @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  progress   MaterialProgress[]
  bookmarks  MaterialBookmark[]

  @@index([chapterId, status, order])
  @@index([status, createdAt])
}

model MaterialProgress {
  id          String    @id @default(cuid())
  userId      String
  materialId  String
  openedAt    DateTime  @default(now())
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  material    Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([materialId])
}

model MaterialBookmark {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([materialId])
}

model SubjectBookmark {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([subjectId])
}

/// Uploaded study files when STORAGE_DRIVER="database" (hosts with a read-only disk, such as Vercel).
model StoredFile {
  key       String   @id
  data      Bytes
  createdAt DateTime @default(now())
}

/// Subjects chosen for one student. A student with any of these rows sees exactly those subjects;
/// a student with none falls back to the semester rule in visibility.ts.
model StudentSubject {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([subjectId])
}

/// A timed, MCQ-based test for one subject (e.g. a weekly test). Written by hand by an admin — no AI involved,
/// so no per-run cost. `questions` is validated against lib/test.ts before it is ever stored.
model Test {
  id              String        @id @default(cuid())
  subjectId       String
  title           String
  description     String        @default("")
  durationMinutes Int
  questions       Json
  status          ContentStatus @default(DRAFT)
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  subject   Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("CreatedTests", fields: [createdById], references: [id], onDelete: SetNull)
  attempts  TestAttempt[]

  @@index([subjectId, status, createdAt])
}

/// One student's attempt at one test: one row per (test, user), created the moment they press Start, which is
/// also what "one attempt only" means here — a second Start for the same test finds this row instead of a new one.
/// `answers[i]` is the option index the student picked for question i (or null), kept in step with the server's
/// own clock so nothing they change locally (their clock, the page, a retry) can extend their time or their score.
model TestAttempt {
  id          String    @id @default(cuid())
  testId      String
  userId      String
  answers     Json      @default("[]")
  score       Int?
  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([testId, userId])
  @@index([testId])
}

/// One StudyHub usage fee for one student for one period (e.g. "September 2026"). This is a record the admin
/// keeps, not a payment processor: no money moves through the app. Payment happens off-platform (cash, bank
/// transfer, WhatsApp) and the admin marks it Paid here once received.
model Fee {
  id        String    @id @default(cuid())
  userId    String
  amount    Int
  /// Free text naming the period this fee is for, e.g. "September 2026" or "Semester 1". Unique per student so
  /// generating fees for the same period twice does not double-charge anyone by accident.
  period    String
  dueDate   DateTime?
  status    FeeStatus @default(PENDING)
  paidAt    DateTime?
  note      String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([userId, status])
  @@index([status, dueDate])
}

/// A message from the admins on students' dashboards. courseId empty means every student; otherwise only that program.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  courseId  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([active, createdAt])
  @@index([courseId])
}
