{
  "name": "studyhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:seed:demo": "tsx --env-file=.env prisma/seed.ts --demo",
    "postinstall": "prisma generate",
    "test:e2e:clean": "tsx --env-file=.env tests/e2e/cleanup.ts",
    "test:e2e": "npm run test:e2e:clean && node --env-file=.env tests/e2e/auth.e2e.mjs && npm run test:e2e:clean && node --env-file=.env tests/e2e/admin.e2e.mjs && npm run test:e2e:clean && node --env-file=.env tests/e2e/materials.e2e.mjs && npm run test:e2e:clean && node --env-file=.env tests/e2e/semesters.e2e.mjs && npm run test:e2e:clean && node --env-file=.env tests/e2e/student.e2e.mjs && npm run test:e2e:clean && node --env-file=.env tests/e2e/engagement.e2e.mjs && npm run test:e2e:clean"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.19.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
